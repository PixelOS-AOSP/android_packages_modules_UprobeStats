# proto-file: config.proto
# proto-message: UprobestatsConfig

tasks {
    probe_configs: {
        bpf_name: "prog_BitmapAllocation_uprobe_bitmap_constructor_heap"
        bpf_map: "map_BitmapAllocation_output_buf"
        file_paths: "/system/priv-app/Telecom/oat/arm64/Telecom.odex"
        method_signature: "void com.android.server.telecom.TelecomServiceImpl$1.placeCall(android.net.Uri, android.os.Bundle, java.lang.String, java.lang.String)"
    }
    target_process_name: "system_server"
    duration_seconds: 60
}
