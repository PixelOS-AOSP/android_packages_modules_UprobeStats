package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_system_performance",
}

rust_defaults {
    name: "uprobestats_apex_defaults",
    apex_available: [
        "//apex_available:platform",
        "com.android.uprobestats",
    ],
    min_sdk_version: "36",
}

rust_defaults {
    name: "uprobestats_core_rustlibs_defaults",
    rustlibs: [
        "libanyhow",
        "liblog_rust",
        "liblogger",
        "libthiserror",
    ],
}

rust_defaults {
    name: "uprobestats_flags_rustlibs_defaults",
    rustlibs: [
        "libuprobestats_flags_rust",
        "libuprobestats_mainline_flags_rust",
    ],
}

rust_defaults {
    name: "uprobestats_proto_rustlibs_defaults",
    rustlibs: [
        "libprotobuf",
        "libuprobestats_proto",
    ],
}

rust_defaults {
    name: "uprobestats_features_defaults",
    features: select(release_flag("RELEASE_UPROBESTATS_BRIDGE_SERVICE"), {
        true: ["bridge-service"],
        default: [],
    }) + select(release_flag("RELEASE_UPROBESTATS_SERVICE"), {
        true: ["binder-service"],
        default: [],
    }) + select(product_variable("debuggable"), {
        true: ["art-test"],
        false: [],
    }),
}

rust_binary {
    name: "uprobestats",
    srcs: ["uprobestats.rs"],
    defaults: [
        "uprobestats_apex_defaults",
        "uprobestats_features_defaults",
        "uprobestats_flags_rustlibs_defaults",
        "uprobestats_core_rustlibs_defaults",
        "uprobestats_flags_rustlibs_defaults",
    ],
    prefer_rlib: true,
    rustlibs: [
        "libatrace_rust",
        "libbinder_rs",
        "librustutils",
        "libstatslog_uprobestats_rs",
        "libuprobestats_android",
        "uprobestats-service-aidl-rust",
    ],
}
