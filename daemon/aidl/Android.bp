package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "uprobestats-service-aidl",
    srcs: ["com/android/uprobestats/IUprobeStatsService.aidl"],
    unstable: true,
    min_sdk_version: "36",
    backend: {
        ndk: {
            enabled: true,
            apex_available: ["com.android.uprobestats"],
        },
        rust: {
            enabled: true,
            apex_available: ["com.android.uprobestats"],
        },
    },
}
