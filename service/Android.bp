package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "uprobestats-bridge-service-sources",
    srcs: [
        "java/**/*.java",
    ],
}

java_library {
    enabled: select(release_flag("RELEASE_UPROBESTATS_BRIDGE_SERVICE"), {
        true: true,
        default: false,
    }),
    srcs: [":uprobestats-bridge-service-sources"],
    name: "service-uprobestats-bridge",
    defaults: ["standalone-system-server-module-optimize-defaults"],
    installable: true,
    libs: [
        "androidx.annotation_annotation",
        "framework-annotations-lib",
        "framework-configinfrastructure.stubs.module_lib",
    ],
    static_libs: [
        "androidx.annotation_annotation",
        "uprobestats-bridge-service-aidl-java",
        "uprobestats_mainline_flags_java_lib",
    ],
    sdk_version: "system_server_current",
    min_sdk_version: "36",
    apex_available: ["com.android.uprobestats"],
    visibility: ["//packages/modules/UprobeStats/apex"],
}
