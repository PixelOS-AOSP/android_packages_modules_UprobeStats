package: "com.android.uprobestats.flags"
container: "com.android.uprobestats"

# keep-sorted start block=yes newline_separated=yes
flag {
    name: "a11y_runtime_permission"
    namespace: "responsible_apis"
    description: "Whether to enable instrumentation of a11y services self-granting runtime permission"
    bug: "427180586"
}

flag {
    name: "uprobestats_service"
    namespace: "responsible_apis"
    description: "Whether to run the uprobestats daemon as a binder service, instead of a process that is just started via setting a `ctl.start` property"
    bug: "471001249"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
}
# keep-sorted end
