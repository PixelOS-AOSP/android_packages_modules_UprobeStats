rust_library {
    name: "libuprobestats_rs",
    crate_name: "uprobestats_rs",
    defaults: [
        "uprobestats_apex_defaults",
        "uprobestats_core_rustlibs_defaults",
        "uprobestats_features_defaults",
        "uprobestats_flags_rustlibs_defaults",
        "uprobestats_proto_rustlibs_defaults",
    ],
    srcs: ["lib.rs"],
    rustlibs: [
        "libactivity_manager_rs",
        "libbinder_rs",
        "libdynamic_instrumentation_manager",
        "librand",
        "librustutils",
        "libstatslog_uprobestats_rs",
        "libstatssocket_rs",
        "libuprobestats_bpf",
        "libuprobestats_bpf_bindgen",
        "libuprobestats_core",
        "libzerocopy",
        "uprobestats-bridge-service-aidl-rust",
        "uprobestats-service-aidl-rust",
    ],
}

rust_binary {
    name: "uprobestats_rs",
    stem: "uprobestats",
    enabled: select(release_flag("RELEASE_UPROBESTATS_RUST"), {
        true: true,
        false: false,
    }),
    srcs: ["main.rs"],
    defaults: [
        "uprobestats_apex_defaults",
        "uprobestats_features_defaults",
        "uprobestats_core_rustlibs_defaults",
    ],
    prefer_rlib: true,
    rustlibs: [
        "libatrace_rust",
        "libbinder_rs",
        "librustutils",
        "libuprobestats_rs",
        "uprobestats-service-aidl-rust",
    ],
}
