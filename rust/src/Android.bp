rust_defaults {
    name: "libuprobestats_rs_defaults",
    srcs: ["lib.rs"],
    rustlibs: [
        "libactivity_manager_rs",
        "libbinder_rs",
        "libdynamic_instrumentation_manager",
        "liblog_rust",
        "liblogger",
        "libprotobuf",
        "libuprobestats_bpf",
        "libuprobestats_bpf_bindgen",
        "libuprobestats_proto",
        "librustutils",
        "libstatslog_uprobestats_rs",
        "libstatssocket_rs",
        "libuprobestats_flags_rust",
        "libuprobestats_mainline_flags_rust",
        "libzerocopy",
        "uprobestats-bridge-service-aidl-rust",
        "uprobestats-service-aidl-rust",
    ],
    shared_libs: ["libuprobestats_bpf_cc"],
    features: select(release_flag("RELEASE_UPROBESTATS_BRIDGE_SERVICE"), {
        true: ["bridge-service"],
        default: [],
    }) + select(release_flag("RELEASE_UPROBESTATS_SERVICE"), {
        true: ["binder-service"],
        default: [],
    }) + select(product_variable("debuggable"), {
        true: ["art-test"],
        false: [],
    }),
}

rust_library {
    name: "libuprobestats_rs",
    crate_name: "uprobestats_rs",
    defaults: [
        "uprobestats_rust_defaults",
        "libuprobestats_rs_defaults",
    ],
}

rust_test_host {
    name: "uprobestats-guardrail-test",
    defaults: [
        "uprobestats_rust_defaults",
    ],
    srcs: ["guardrail.rs"],
    rustlibs: ["libuprobestats_proto"],
    test_suites: ["general-tests"],
}

rust_binary {
    name: "uprobestats_rs",
    stem: "uprobestats",
    enabled: select(release_flag("RELEASE_UPROBESTATS_RUST"), {
        true: true,
        false: false,
    }),
    srcs: ["main.rs"],
    defaults: ["uprobestats_rust_defaults"],
    prefer_rlib: true,
    rustlibs: [
        "libuprobestats_rs",
        "libatrace_rust",
        "libbinder_rs",
        "liblog_rust",
        "liblogger",
        "librustutils",
        "uprobestats-service-aidl-rust",
    ],
    features: select(release_flag("RELEASE_UPROBESTATS_SERVICE"), {
        true: ["binder-service"],
        default: [],
    }),
}
