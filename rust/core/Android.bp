rust_library {
    name: "libuprobestats_core",
    crate_name: "uprobestats_core",
    defaults: [
        "uprobestats_apex_defaults",
        "uprobestats_core_rustlibs_defaults",
        "uprobestats_flags_rustlibs_defaults",
        "uprobestats_proto_rustlibs_defaults",
    ],
    srcs: ["uprobestats_core.rs"],
}

rust_test_host {
    name: "uprobestats-core-test",
    defaults: [
        "uprobestats_core_rustlibs_defaults",
        "uprobestats_flags_rustlibs_defaults",
        "uprobestats_proto_rustlibs_defaults",
    ],
    srcs: ["uprobestats_core.rs"],
    test_suites: ["general-tests"],
}
