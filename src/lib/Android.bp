soong_config_module_type {
    name: "libuprobestats_client_cc_library_shared",
    module_type: "cc_library_shared",
    config_namespace: "ANDROID",
    properties: [
        "stubs",
        "min_sdk_version",
        "apex_available",
    ],
}

libuprobestats_client_cc_library_shared {
    name: "libuprobestats_client",
    stubs: {
        symbol_file: "libcom.android.uprobestats.client.map.txt",
    },
    min_sdk_version: "35",
    apex_available: [
        "com.android.uprobestats",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-enum-compare",
        "-Wno-unused-function",
    ],
    srcs: select(release_flag("RELEASE_UPROBESTATS_SERVICE"), {
        true: ["uprobestats_service_client.cpp"],
        default: ["uprobestats_client.cpp"],
    }),
    shared_libs: select(release_flag("RELEASE_UPROBESTATS_SERVICE"), {
        true: [
            "libbase",
            "libbinder_ndk",
            "uprobestats-service-aidl-ndk",
        ],
        default: ["libbase"],
    }),
    export_include_dirs: ["include"],
    header_libs: ["libcutils_headers"],
}
