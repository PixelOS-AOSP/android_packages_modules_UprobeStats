package {
    default_visibility: [":__pkg__"],
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "framework-uprobestats-sources",
    defaults: ["framework-sources-module-defaults"],
    srcs: [
        "java/**/*.java",
        ":uprobestats-bridge-service-aidl-sources",
    ],
    visibility: ["//packages/modules/Uprobestats/framework:__subpackages__"],
}

java_sdk_library {
    name: "framework-uprobestats",
    defaults: ["framework-module-defaults"],
    installable: true,

    jarjar_rules: "jarjar-rules.txt",

    srcs: [
        ":framework-uprobestats-sources",
    ],

    libs: [
        "androidx.annotation_annotation",
    ],

    aconfig_declarations: [
        "uprobestats_mainline_flags",
    ],

    static_libs: [
        "uprobestats_mainline_flags_java_lib",
    ],

    permitted_packages: [
        "android.uprobestats.mainline.flags",
        "com.android.uprobestats",
        "android.service.uprobestats",
        "android.annotation",
        "com.android.internal.annotations",
        "android.ravenwood.annotation",
    ],

    api_packages: [
        "android.service.uprobestats",
    ],

    hostdex: true, // for hiddenapi check

    impl_library_visibility: [
        "//packages/modules/Uprobestats/service:__subpackages__",
        "//packages/modules/Uprobestats/tests:__subpackages__",
        "//packages/modules/UprobeStats/tests/e2e:__subpackages__",
    ],

    apex_available: [
        "com.android.uprobestats",
    ],
    min_sdk_version: "36",
}
